---
import SmartImage from '../SmartImage.astro';
import PageView from '../comments/PageView.astro';
import FormattedDate from '../FormattedDate.astro';
import MetadataItem from '../MetadataItem.astro';
import { getSiteConfig } from '../../data/site';
import { getUiText } from '../../utils/ui-text';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  wordCount: number;
  readingTime: string;
  heroImage?: ImageMetadata | string;
  showHeroImage?: boolean;
  variant?: 'default' | 'archive';
  kicker?: string;
  note?: string;
  pathname?: string;
  showPageView?: boolean;
}

const {
  title,
  description,
  date,
  wordCount,
  readingTime,
  heroImage,
  showHeroImage = true,
  variant = 'default',
  kicker = 'Article',
  note,
  pathname = Astro.url.pathname,
  showPageView = false,
} = Astro.props;
const isArchiveHeader = variant === 'archive';
const ui = getUiText(await getSiteConfig());
const wordCountLabel = ui.article.wordCount(wordCount);
---

<header
  class:list={[
    'article-header',
    { 'article-header-archive': isArchiveHeader, 'archive-header-shared': isArchiveHeader },
  ]}
>
  {
    isArchiveHeader ? (
      <>
        <div class="archive-heading archive-header-main">
          <p class="archive-kicker">{kicker}</p>
          <h1 class="archive-title" data-pagefind-meta="title">
            {title}
          </h1>
          <div class="meta-line" aria-label={ui.article.metadata}>
            {date && (
              <MetadataItem kind="date" separated={false}>
                <FormattedDate date={date} />
              </MetadataItem>
            )}
            <MetadataItem kind="words" separated={Boolean(date)}>
              {wordCountLabel}
            </MetadataItem>
            <MetadataItem kind="reading">{readingTime}</MetadataItem>
            {showPageView && <PageView pathname={pathname} />}
          </div>
        </div>
        {(description || note) && (
          <div class="archive-copy">
            {description && <p class="archive-subtitle">{description}</p>}
            {note && <p class="archive-note">{note}</p>}
          </div>
        )}
      </>
    ) : (
      <>
        <h1 data-pagefind-meta="title">{title}</h1>

        <div class="meta-line" aria-label={ui.article.metadata}>
          {date && (
            <MetadataItem kind="date" separated={false}>
              <FormattedDate date={date} />
            </MetadataItem>
          )}
          <MetadataItem kind="words" separated={Boolean(date)}>
            {wordCountLabel}
          </MetadataItem>
          <MetadataItem kind="reading">{readingTime}</MetadataItem>
          {showPageView && <PageView pathname={pathname} />}
        </div>
      </>
    )
  }

  {
    showHeroImage && heroImage && (
      <figure class="article-hero-image">
        <SmartImage width={1020} height={510} src={heroImage} alt="" />
      </figure>
    )
  }
</header>

<style>
  .article-header {
    display: grid;
    gap: 14px;
    width: 100%;
    max-width: var(--article-content-max, 720px);
    margin-bottom: 34px;
  }

  .article-header-archive {
    max-width: none;
    margin-bottom: 54px;
  }

  .archive-heading {
    min-width: 0;
  }

  h1 {
    margin: 0;
    color: var(--paper-ink);
    font-family: var(--font-heading);
    font-size: clamp(2.15rem, 4.8vw, 3.45rem);
    font-weight: 400;
    line-height: 1.08;
  }

  :global(.article-content-ui) h1 {
    font-family: var(--font-page-heading);
  }

  .archive-heading .meta-line {
    margin-top: 14px;
  }

  .meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 6px;
    color: var(--paper-ink-faint);
    font-family: var(--font-meta);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .article-hero-image {
    width: 100%;
    height: 84px;
    margin: 10px 0 0;
    overflow: hidden;
    border: 1px solid var(--paper-line);
    border-radius: 7px;
    background: var(--paper-surface-muted);
  }

  .article-hero-image :global(img) {
    display: block;
    width: 100%;
    height: 84px;
    object-fit: cover;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    filter: saturate(0.72) contrast(0.96);
  }

  @media (max-width: 640px) {
    .article-header {
      gap: 12px;
      margin-bottom: 30px;
    }

    .article-header-archive {
      margin-bottom: 34px;
    }

    h1 {
      font-size: 2.08rem;
      line-height: 1.1;
    }

    .article-hero-image,
    .article-hero-image :global(img) {
      height: 84px;
      border-radius: 6px;
    }
  }
</style>
