---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';

const [about] = await getCollection('about');

if (!about) {
  throw new Error('Missing src/content/about.mdx content entry.');
}

const { Content, headings } = await render(about);
---

<ArticleLayout
  post={about}
  headings={headings}
  sidebar={{ enable: false, ...about.data.sidebar }}
  contentFont="ui"
>
  <Content />
</ArticleLayout>
