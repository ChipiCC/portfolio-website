---
import ArticleHeader from '../components/article/ArticleHeader.astro';
import TopNav from '../components/TopNav.astro';
import ScrollToTopButton from '../components/ScrollToTopButton.astro';
import TableOfContents from '../components/article/TableOfContents.astro';
import BaseHead from '../components/BaseHead.astro';
import CommentSection from '../components/comments/CommentSection.astro';
import ZoomableImage from '../components/mdx/ZoomableImage.astro';
import { getThemePalette, getSiteConfig } from '../data/site';
import { resolveCommentsConfig } from '../utils/comments';
import { buildTocTree, countTocItems } from '../utils/toc-tree';
import { getUiText } from '../utils/ui-text';

const siteConfig = await getSiteConfig();
const { comments: rawComments } = siteConfig;
const comments = resolveCommentsConfig(rawComments);
const ui = getUiText(siteConfig);

type SidebarConfig = {
  enable?: boolean;
  toc?: boolean;
};

interface Props {
  post?: {
    id: string;
    body?: string;
    data: {
      title: string;
      description: string;
      date: Date;
      heroImage?: ImageMetadata | string;
      showHeroImage?: boolean;
      comments?: boolean;
      sidebar?: SidebarConfig;
    };
  };
  headings?: { depth: number; slug: string; text: string }[];
  sidebar?: SidebarConfig;
  headerVariant?: 'default' | 'archive';
  headerKicker?: string;
  headerNote?: string;
  title?: string;
  description?: string;
  date?: Date;
  heroImage?: ImageMetadata | string;
  showHeroImage?: boolean;
  contentFont?: 'article' | 'ui';
}

const props = Astro.props;
const palette = await getThemePalette();
const headings = props.headings ?? [];
const post = props.post ?? {
  id: 'standalone',
  body: props.description ?? '',
  data: {
    title: props.title ?? 'Untitled',
    description: props.description ?? '',
    date: props.date ?? new Date(),
    heroImage: props.heroImage,
    showHeroImage: props.showHeroImage ?? true,
    sidebar: { enable: true, toc: true },
  },
};
const { title, description, date, heroImage, showHeroImage = true } = post.data;
const contentFont = props.contentFont ?? 'article';
const bodyText = 'body' in post && typeof post.body === 'string' ? post.body : description;
const englishWords = bodyText.match(/[A-Za-z0-9]+(?:['’-][A-Za-z0-9]+)*/g) ?? [];
const wordCount = englishWords.length;
const readingMinutes = Math.max(1, Math.ceil(englishWords.length / 220));
const readingTime = ui.article.readingTime(readingMinutes);
const tocItems = buildTocTree(headings);
const tocItemCount = countTocItems(tocItems);
const sidebarConfig = {
  enable: true,
  toc: true,
  ...post.data.sidebar,
  ...props.sidebar,
};
const shouldRenderSidebar = sidebarConfig.enable ?? true;
const shouldRenderToc = sidebarConfig.toc ?? true;
const hasToc = shouldRenderToc && tocItemCount > 0;
const hasSidebar = shouldRenderSidebar && hasToc;
---

<!doctype html>
<html lang={ui.locale} data-palette={palette}>
  <head>
    <BaseHead title={title} description={description} />
    {
      comments.provider === 'waline' && comments.enabled && (
        <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
      )
    }
  </head>
  <body class:list={['article-detail-page', { 'article-content-ui': contentFont === 'ui' }]}>
    <TopNav showTocIcon={hasToc} tocItems={tocItems} />
    <div class="article-background" aria-hidden="true"></div>

    <main
      class:list={['article-layout', { 'article-layout-centered': !hasSidebar }]}
      data-pagefind-body
    >
      <div class="article-column">
        <article class="article-card">
          <ArticleHeader
            title={title}
            description={description}
            date={date}
            wordCount={wordCount}
            readingTime={readingTime}
            heroImage={heroImage}
            showHeroImage={showHeroImage}
            variant={props.headerVariant}
            kicker={props.headerKicker}
            note={props.headerNote}
            pathname={Astro.url.pathname}
            showPageView={comments.enabled}
          />

          {
            hasToc && (
              <section class="mobile-article-toc" aria-label={ui.toc.title}>
                <TableOfContents items={tocItems} compact collapsible font={contentFont} />
              </section>
            )
          }

          <section
            id="article-start"
            class:list={['article-content', { 'article-content-ui': contentFont === 'ui' }]}
          >
            <slot />
          </section>
        </article>
        <CommentSection frontmatter={post.data} pathname={Astro.url.pathname} />
      </div>

      {
        hasSidebar && (
          <aside class="right-sidebar" aria-label={ui.article.readingTools}>
            <div class="right-sidebar-inner">
              {hasToc && <TableOfContents items={tocItems} font={contentFont} />}
            </div>
          </aside>
        )
      }
    </main>
    <ScrollToTopButton />
    <ZoomableImage />
  </body>
</html>

<style>
  :global(html) {
    background: var(--paper-bg);
    scroll-behavior: smooth;
  }

  :global(.article-detail-page) {
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--paper-detail-bg);
    color: var(--paper-ink);
  }

  .article-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .article-background::before {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--paper-rule) 1px, transparent 1px);
    background-size: 100% 34px;
    content: '';
    opacity: 0.2;
  }

  .article-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 780px) 252px;
    gap: 48px;
    width: min(100%, var(--layout-shell-width));
    max-width: none;
    margin: 0 auto;
    padding: var(--layout-page-top) var(--layout-page-gutter) var(--layout-page-bottom);
  }

  .article-layout-centered {
    display: block;
    width: min(100%, var(--layout-shell-width));
  }

  .article-column {
    min-width: 0;
  }

  .article-layout-centered .article-column {
    width: 100%;
    margin: 0 auto;
  }

  .article-layout-centered .article-card {
    --article-content-max: 100%;
  }

  .article-layout-centered .article-content {
    max-width: none;
  }

  .right-sidebar-inner {
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .right-sidebar-inner {
    position: sticky;
    top: 96px;
    align-self: start;
  }

  :global(.article-panel) {
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-surface);
    box-shadow: var(--paper-shadow);
  }

  .article-card {
    --article-content-max: 720px;
    overflow: visible;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .article-content {
    width: min(100%, var(--article-content-max));
    max-width: var(--article-content-max);
    min-width: 0;
    color: var(--paper-ink);
    font-family: var(--font-article);
    font-size: 18px;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .article-content-ui {
    font-family: var(--font-serif);
  }

  .article-content :global(h1),
  .article-content :global(h2) {
    color: var(--paper-ink);
    font-family: var(--font-heading);
    line-height: 1.2;
  }

  .article-content :global(h1) {
    margin-top: 64px;
    margin-bottom: 24px;
    font-size: 2.25rem;
  }

  .article-content :global(h2) {
    margin-top: 56px;
    margin-bottom: 20px;
    font-size: 1.9rem;
  }

  .article-content :global(h3) {
    margin-top: 38px;
    margin-bottom: 16px;
    color: var(--paper-ink);
    font-family: var(--font-heading);
    font-size: 1.35rem;
  }

  .article-content :global(h4),
  .article-content :global(h5),
  .article-content :global(h6) {
    margin-top: 30px;
    margin-bottom: 12px;
    color: var(--paper-ink);
    font-family: var(--font-heading);
    font-size: 1em;
    line-height: 1.35;
  }

  .article-content-ui :global(h1),
  .article-content-ui :global(h2),
  .article-content-ui :global(h3),
  .article-content-ui :global(h4),
  .article-content-ui :global(h5),
  .article-content-ui :global(h6) {
    font-family: var(--font-page-heading);
  }

  .article-content :global(p) {
    margin: 0 0 22px;
  }

  .article-content :global(a) {
    color: var(--paper-accent);
    font-weight: 700;
    text-decoration-color: rgba(102, 125, 109, 0.32);
    text-underline-offset: 4px;
  }

  .article-content :global(blockquote) {
    margin: 34px 0;
    padding: 18px 22px 18px 26px;
    border: 1px solid var(--paper-line);
    border-left: 3px solid rgba(102, 125, 109, 0.42);
    border-radius: 7px;
    background: var(--paper-surface-muted);
    color: var(--paper-ink);
    font-family: var(--font-article);
    font-size: 1.08rem;
  }

  .article-content :global(pre:not([data-language])),
  .code-block {
    overflow-x: auto;
    border: 1px solid var(--paper-line-strong);
    border-radius: 7px;
    background: var(--paper-surface-muted);
    color: var(--paper-ink);
  }

  .article-content :global(pre:not([data-language])) {
    padding: 20px;
  }

  .article-content :global(:not(pre) > code) {
    font-family: var(--font-code);
    border-radius: 7px;
    background: var(--paper-control);
    color: var(--paper-ink);
  }

  .article-content :global(pre:not([data-language]) > code) {
    background: transparent;
  }

  .article-content :global(.expressive-code) {
    margin: 28px 0 30px;
    font-family: var(--font-code);
  }

  .article-content :global(.expressive-code .frame) {
    overflow: hidden;
    border-radius: 7px;
  }

  .code-block {
    font-family: var(--font-code);
    margin: 0;
    padding: 20px;
    font-size: 0.9rem;
  }

  .mobile-article-toc {
    display: none;
  }

  @media (max-width: 1180px) {
    .article-layout {
      grid-template-columns: minmax(0, 720px) 238px;
      justify-content: center;
      width: min(100%, 1040px);
    }

    .article-layout-centered {
      display: block;
      width: min(100%, var(--layout-shell-width));
    }
  }

  @media (max-width: 900px) {
    .article-layout {
      display: block;
      max-width: 760px;
      padding: 88px 16px 36px;
    }

    .right-sidebar {
      display: none;
    }

    .mobile-article-toc {
      display: block;
      width: min(100%, var(--article-content-max));
      max-width: var(--article-content-max);
      margin: -10px 0 28px;
    }
  }

  @media (max-width: 640px) {
    .article-card {
      padding: 0;
      border-radius: 8px;
    }
  }
</style>
